# The positionR citation comes first in every package of the suite, then the
# package's own. Both text versions write the author as "Brownscombe JW", as
# the other packages of the suite do.
maintainer <- person(c("Jacob", "W."), "Brownscombe", email = "jakebrownscombe@gmail.com",
                     comment = c(ORCID = "0000-0003-2496-8764"))

bibentry(
  bibtype = "Manual",
  title = "positionR: tools for acoustic telemetry studies",
  author = person(c("Jacob", "W."), "Brownscombe", email = maintainer$email,
                  comment = maintainer$comment),
  year = "2026",
  note = "R package version 2.0.0",
  url = "https://jakebrownscombe.github.io/positionR/",
  textVersion = paste0(
    "Brownscombe JW (2026). positionR: tools for acoustic telemetry studies. ",
    "R package version 2.0.0, https://jakebrownscombe.github.io/positionR/."
  )
)

bibentry(
  bibtype = "Manual",
  title = paste0("detqc: ", meta$Title),
  author = maintainer,
  year = "2026",
  note = paste("R package version", meta$Version),
  url = "https://jakebrownscombe.github.io/detqc/",
  textVersion = paste0(
    "Brownscombe JW (2026). detqc: ", meta$Title, ". ",
    "R package version ", meta$Version, ". https://jakebrownscombe.github.io/detqc/"
  )
)
